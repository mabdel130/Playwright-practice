{
  "name": "Playwright-practice",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:dev": "cross-env TEST_ENV=dev playwright test tests/suites/RahulShettyClient",
    "test:test": "cross-env TEST_ENV=test playwright test tests/suites/RahulShettyClient",
    "test:staging": "cross-env TEST_ENV=staging playwright test tests/suites/RahulShettyClient",
    "test:prod": "cross-env TEST_ENV=prod playwright test tests/suites/RahulShettyClient",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean --single-file -o allure-report",
    "allure:open": "allure open allure-report",
    "test:report:allure": "npm run allure:generate && npm run allure:open",
    "test:watch": "cross-env TEST_ENV=test SLOWMO=800 playwright test tests/suites/RahulShettyClient --project=chromium --headed --workers=1 --timeout=300000",
    "report:all": "npm run allure:generate && playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^8.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.12.2",
    "cross-env": "^7.0.3"
  }
}
