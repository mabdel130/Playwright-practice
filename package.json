{
  "name": "Playwright-practice",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:dev": "cross-env TEST_ENV=dev playwright test tests/suites/RahulShettyClient",
    "test:test": "cross-env TEST_ENV=test playwright test tests/suites/RahulShettyClient",
    "test:staging": "cross-env TEST_ENV=staging playwright test tests/suites/RahulShettyClient",
    "test:prod": "cross-env TEST_ENV=prod playwright test tests/suites/RahulShettyClient",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test:report:allure": "npm run allure:generate && npm run allure:open",
    "test:debug": "cross-env DEBUG_API=1 DEVTOOLS=1 playwright test --project=chromium --headed --workers=1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint tests scripts --ignore-pattern tests/Typescript_Fundamentals",
    "check:antipatterns": "node scripts/check-antipatterns.js",
    "test:unit": "cross-env UNIT_ONLY=1 playwright test --project=unit",
    "metrics": "node scripts/metrics.js",
    "verify": "npm run typecheck && npm run lint && npm run check:antipatterns && npm run test:unit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^8.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.12.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
