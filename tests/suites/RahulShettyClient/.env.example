# Template - copy to .env in this folder and fill in the values.
# Priority: real environment / CI secrets > .env.<TEST_ENV> > .env


# Registered user (TC01, TC02, order / cart flows)
CLIENT_USER_EMAIL=
CLIENT_USER_PASSWORD=

# Negative login cases (TC02, TC03)
CLIENT_WRONG_PASSWORD=
CLIENT_UNREGISTERED_EMAIL=
CLIENT_UNREGISTERED_PASSWORD=

# New user registered by the e2e flow ({{timestamp}} makes it unique each run)
CLIENT_E2E_EMAIL=
CLIENT_E2E_PASSWORD=
